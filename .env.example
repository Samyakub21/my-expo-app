# DhanVayu Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ===========================================
# FIREBASE CONFIGURATION
# Get these from Firebase Console > Project Settings > General
# ===========================================
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:android:abcdef123456

# ===========================================
# GOOGLE OAUTH CONFIGURATION
# Get these from Google Cloud Console > APIs & Services > Credentials
# ===========================================
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# ===========================================
# ADMOB CONFIGURATION (Optional - for monetization)
# Get these from AdMob Console
# ===========================================
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# ===========================================
# AI CONFIGURATION (Optional)
# ===========================================
# EXPO_PUBLIC_GEMINI_PROXY_URL=https://your-proxy.vercel.app/
